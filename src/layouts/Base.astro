---
import '../styles/global.css';
const { lang, title, description, urls } = Astro.props;
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const abs = (p) => (Astro.site ? new URL(p, Astro.site).href : null);
const canonical = abs(urls[lang]);
const fonts = lang === 'fa'
  ? 'family=Vazirmatn:wght@400;500;700'
  : 'family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;500';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f161c" media="(prefers-color-scheme: dark)" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="en" href={abs(urls.en)} />}
    {canonical && <link rel="alternate" hreflang="fa" href={abs(urls.fa)} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(urls.en)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232447f5'/%3E%3Cpath d='M9 22V10h7a4 4 0 010 8h-7' fill='none' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
