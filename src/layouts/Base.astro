---
import '../styles/main.scss';
import type { Lang } from '../data/types';
import { buildThemeAssets } from '../theme/css';
import { activePresetName, presets, theme } from '../theme';
import { assertThemes } from '../theme/validate';
import { site } from '../config/site.config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  urls: Record<Lang, string>;
  name: string;
  jobTitle: string;
}

const { lang, title, description, urls, name, jobTitle } = Astro.props;
const dev = import.meta.env.DEV;
// Loaded only in dev so the panel's code and styles never reach a production build.
const ThemeLab = dev ? (await import('../components/ThemeLab.astro')).default : null;
// Production validates the active theme (and fails the build); dev validates all presets and only warns.
assertThemes(dev ? Object.values(presets) : [theme], !dev);
const assets = buildThemeAssets(theme, lang, dev ? Object.values(presets).filter((p) => p !== theme) : []);
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const abs = (path: string): string | null => (Astro.site ? new URL(path, Astro.site).href : null);
const canonical = abs(urls[lang]);
const ld = { '@context': 'https://schema.org', '@type': 'Person', name, jobTitle, inLanguage: lang, ...(canonical ? { url: canonical } : {}) };
---
<!doctype html>
<html lang={lang} dir={dir} data-hero={site.variants.hero} data-work={site.variants.work}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={assets.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={assets.themeColor.dark} media="(prefers-color-scheme: dark)" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="en" href={abs(urls.en)} />}
    {canonical && <link rel="alternate" hreflang="fa" href={abs(urls.fa)} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(urls.en)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={assets.favicon} />
    {assets.preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <style is:inline set:html={assets.css} />
    {dev && <script is:inline>{`try{var d=document.documentElement,k=['preset','hero','work'];k.forEach(function(n){var v=localStorage.getItem('lab-'+n);if(v)d.setAttribute('data-'+n,v)})}catch(e){}`}</script>}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      /* Runs before first paint. ES5 on purpose: it must work in every browser. */
      (function () {
        var d = document.documentElement, w = window, n = navigator, t, tier = 'high', s;
        var enhanced = 'noModule' in HTMLScriptElement.prototype && 'IntersectionObserver' in w;
        if (enhanced) d.classList.add('js');

        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = w.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);

        // Device tier from capability signals (not the user-agent string). The page script refines it by measuring frame rate.
        var c = n.connection || n.mozConnection || n.webkitConnection || {};
        var mem = n.deviceMemory, cores = n.hardwareConcurrency, et = c.effectiveType || '';
        if (c.saveData || /2g$/.test(et) || (mem && mem <= 2) || (cores && cores <= 2) ||
            (w.matchMedia && matchMedia('(prefers-reduced-data: reduce)').matches)) tier = 'low';
        else if ((mem && mem <= 4) || (cores && cores <= 4) || et === '3g') tier = 'medium';
        try { s = sessionStorage.getItem('perf'); if (s === 'low' || s === 'medium' || s === 'high') tier = s; } catch (e) {}
        d.setAttribute('data-perf', tier);

        document.addEventListener('DOMContentLoaded', function () {
          var h = document.getElementById('top'); if (h) h.classList.add('run');
        });
        // Fail open: if the page script never reports ready, show all content without animation gates.
        setTimeout(function () { if (!d.classList.contains('ready')) d.classList.remove('js'); }, 4000);
      })();
    </script>
  </head>
  <body>
    <slot />
    {ThemeLab && <ThemeLab presets={Object.values(presets).map((p) => ({ name: p.name, label: p.label }))} active={activePresetName} />}
  </body>
</html>
