---
/**
 * Dev-only Theme lab. Base.astro imports this component only when `import.meta.env.DEV` is true, so neither
 * the panel nor its scripts exist in `astro build`. The panel itself is the <theme-lab> element.
 */
import type { Theme } from '../theme/schema';
import type { Lang } from '../theme/vars';

interface Props { presets: Theme[]; active: string; builtin: string[]; lang: Lang }
// "<" is escaped so no preset string can close the script element.
const data = JSON.stringify(Astro.props).replace(/</g, '\\u003c');
---
<script is:inline type="application/json" id="theme-lab-data" set:html={data} />
<theme-lab></theme-lab>
<script>
  import '../scripts/theme-lab/element';
</script>
