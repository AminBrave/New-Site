---
/** Dev-only panel: preview presets and layout variants live. It is not rendered in production builds. */
interface Props { presets: Array<{ name: string; label: string }>; active: string }
const { presets, active } = Astro.props;
---
<aside class="theme-lab" aria-label="Theme lab (development only)">
  <strong>Theme lab</strong>
  <label>Preset
    <select data-lab="preset">{presets.map((p) => <option value={p.name} selected={p.name === active}>{p.label}</option>)}</select>
  </label>
  <label>Hero
    <select data-lab="hero"><option value="split">split</option><option value="centered">centered</option></select>
  </label>
  <label>Work
    <select data-lab="work"><option value="grid">grid</option><option value="list">list</option></select>
  </label>
</aside>
<style is:global>
  .theme-lab { position: fixed; z-index: 99999; inset-block-end: 12px; inset-inline-start: 12px; display: grid; gap: 6px; padding: 10px 12px; border: 1px solid #888; border-radius: 10px; background: #111d; color: #fff; font: 12px/1.3 system-ui, sans-serif; }
  .theme-lab label { display: grid; gap: 2px; }
  .theme-lab select { font: inherit; }
  @media print { .theme-lab { display: none; } }
</style>
<script>
  const root = document.documentElement;
  document.querySelectorAll<HTMLSelectElement>('[data-lab]').forEach((select) => {
    const key = select.dataset.lab as string;
    const saved = root.getAttribute(`data-${key}`);
    if (saved) select.value = saved;
    select.addEventListener('change', () => {
      root.setAttribute(`data-${key}`, select.value);
      try { localStorage.setItem(`lab-${key}`, select.value); } catch { /* storage unavailable */ }
    });
  });
</script>
