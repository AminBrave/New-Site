---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import SkillDialogs from './SkillDialogs.astro';
import WorkDialogs from './WorkDialogs.astro';
import HeroSection from './HeroSection.astro';
import SkillsSection from './SkillsSection.astro';
import ProcessSection from './ProcessSection.astro';
import WorkSection from './WorkSection.astro';
import ResumeSection from './ResumeSection.astro';
import ContactSection from './ContactSection.astro';
import Navigation from './Navigation.astro';
import { content, workShared } from '../data/content';
import type { IconName } from '../lib/icons';
import type { DisciplineId, Lang, SectionId } from '../data/types';

interface Props {
  lang: Lang;
  preload?: string[];
}

const { lang, preload } = Astro.props;
const t = content[lang];
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const urls: Record<Lang, string> = { en: `${root}/`, fa: `${root}/fa/` };
const otherLang: Lang = lang === 'fa' ? 'en' : 'fa';
const fmt = (n: number): string => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const src = (path: string): string => (/^(https?:)?\/\//.test(path) ? path : `${root}/${path.replace(/^\//, '')}`);
const works = t.work.map((w) => ({ ...w, ...workShared[w.id] }));
const meta: Record<DisciplineId, { icon: IconName; color: string }> = {
  ux: { icon: 'ux', color: '#2447f5' },
  woo: { icon: 'cart', color: '#6d33e0' },
  content: { icon: 'content', color: '#0b8a7b' },
};
const discs = t.disciplines.map((d) => ({ ...d, ...meta[d.id] }));
const navIcons: Record<SectionId, IconName> = { top: 'home', skills: 'layers', process: 'route', work: 'briefcase', resume: 'file', contact: 'mail' };
const ids: SectionId[] = ['top', 'skills', 'process', 'work', 'resume', 'contact'];
const year = fmt(new Date().getFullYear()).replace(/[,٬]/g, '');
---
<Base lang={lang} title={`${t.name} | ${t.title}`} description={t.description} urls={urls} name={t.name} jobTitle={t.title} preload={preload}>
  <a class="skip" href="#main">{t.ui.skip}</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="#top"><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
      <noscript><a class="ns-lang" href={urls[otherLang]}>{lang === 'fa' ? 'English' : 'فارسی'}</a></noscript>
      <button class="menu-btn" type="button" data-open="menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mlabel">{t.ui.menu}</span>
      </button>
    </div>
  </header>

  <Navigation lang={lang} t={t} urls={urls} fmt={fmt} ids={ids} navIcons={navIcons} />

  <main id="main">
    <HeroSection t={t} />

    <SkillsSection t={t} discs={discs} />

    <ProcessSection t={t} fmt={fmt} />

    <WorkSection t={t} works={works} />

    <ResumeSection t={t} />

    <ContactSection t={t} />

  </main>

  <SkillDialogs t={t} discs={discs} works={works} fmt={fmt} />

  <WorkDialogs t={t} works={works} fmt={fmt} src={src} />

  <footer><div class="wrap foot"><span>© {year} {t.name}</span><a class="topbtn" href="#top"><Icon name="up" size={16} />{t.ui.backTop}</a></div></footer>
</Base>

<script>
  import { initScrollTracking } from '../scripts/scroll-tracking';
  import { initModalController } from '../scripts/modal-controller';

  /* ---------- helpers ---------- */
  function $<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T | null {
    return scope.querySelector<T>(selector);
  }
  function $$<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T[] {
    return Array.from(scope.querySelectorAll<T>(selector));
  }
  /** Runs one feature in isolation so a failure in one never breaks the others. */
  function run(name: string, init: () => void): void {
    try {
      init();
    } catch (error) {
      console.warn(`[portfolio] ${name} failed`, error);
    }
  }
  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasObserver = 'IntersectionObserver' in window;
  const hero = $('#top');
  const dots = $$<HTMLAnchorElement>('.dots a');

  /* ---------- scroll and section tracking ---------- */
  run('scroll tracking', initScrollTracking);

  /* ---------- dot labels: also show on tap (touch has no hover) ---------- */
  run('dots', () => {
    const timers = new WeakMap<HTMLElement, number>();
    const showTip = (link: HTMLElement): void => {
      link.classList.add('tip');
      window.clearTimeout(timers.get(link));
      timers.set(link, window.setTimeout(() => link.classList.remove('tip'), 2200));
    };
    dots.forEach((link) => {
      link.addEventListener('pointerdown', (event) => event.pointerType !== 'mouse' && showTip(link));
      link.addEventListener('click', () => showTip(link));
    });
  });

  /* ---------- repeating reveal animations ---------- */
  run('reveal', () => {
    if (!hasObserver) return;
    const revealObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.target.classList.toggle('in', entry.isIntersecting)),
      { rootMargin: '0px 0px -8% 0px' },
    );
    $$('[data-reveal], [data-stagger]').forEach((el) => revealObserver.observe(el));
    if (hero) {
      new IntersectionObserver(
        (entries) => entries.forEach((entry) => hero.classList.toggle('run', entry.isIntersecting)),
        { threshold: 0 },
      ).observe(hero);
    }
  });

  /* ---------- modals ---------- */
  run('modals', initModalController);

  /* ---------- theme switch ---------- */
  run('theme', () => {
    const themeSwitch = $('[data-theme-toggle]');
    const syncSwitch = (): void => themeSwitch?.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
    syncSwitch();
    themeSwitch?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* storage unavailable */ }
      syncSwitch();
    });
    const scheme = matchMedia('(prefers-color-scheme: dark)');
    if (typeof scheme.addEventListener === 'function') {
      scheme.addEventListener('change', (event) => {
        let stored: string | null = null;
        try { stored = localStorage.getItem('theme'); } catch { /* storage unavailable */ }
        if (stored) return;
        root.dataset.theme = event.matches ? 'dark' : 'light';
        syncSwitch();
      });
    }
  });

  /* ---------- copy email ---------- */
  run('copy', () => {
    const selectText = (el: Element): void => {
      const range = document.createRange();
      range.selectNodeContents(el);
      const selection = getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };
    $$('[data-copy]').forEach((button) => {
      const label = $('.txt', button);
      if (!label) return;
      const original = label.textContent ?? '';
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          const mail = $('.mail');
          if (mail) selectText(mail); // clipboard unavailable: select the address so it can be copied by hand
        }
        button.classList.add('done');
        label.textContent = button.dataset.done ?? original;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.classList.remove('done');
          label.textContent = original;
        }, 1800);
      });
    });
  });

  /* ---------- adaptive performance: measure real frame rate, then downgrade effects if needed ---------- */
  type Tier = 'high' | 'medium' | 'low';
  const tierRank: Record<Tier, number> = { high: 0, medium: 1, low: 2 };
  const currentTier = (): Tier => (root.dataset.perf === 'low' || root.dataset.perf === 'medium' ? root.dataset.perf : 'high');
  function setTier(tier: Tier): void {
    root.dataset.perf = tier;
    try { sessionStorage.setItem('perf', tier); } catch { /* storage unavailable */ }
  }
  function probeFrameRate(): void {
    if (document.hidden || currentTier() === 'low') return;
    const deltas: number[] = [];
    let previous = 0;
    const tick = (now: number): void => {
      if (document.hidden) return;
      if (previous) deltas.push(now - previous);
      previous = now;
      if (deltas.length < 45) {
        requestAnimationFrame(tick);
        return;
      }
      deltas.sort((a, b) => a - b);
      const median = deltas[Math.floor(deltas.length / 2)];
      const measured: Tier = median > 34 ? 'low' : median > 22 ? 'medium' : 'high';
      setTier(tierRank[measured] > tierRank[currentTier()] ? measured : currentTier());
    };
    requestAnimationFrame(tick);
  }
  run('perf', () => {
    const start = (): void => void window.setTimeout(probeFrameRate, 1800);
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  });

  root.classList.add('ready');
</script>
