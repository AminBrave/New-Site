---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import SkillDialogs from './SkillDialogs.astro';
import WorkDialogs from './WorkDialogs.astro';
import HeroSection from './HeroSection.astro';
import SkillsSection from './SkillsSection.astro';
import ProcessSection from './ProcessSection.astro';
import WorkSection from './WorkSection.astro';
import ResumeSection from './ResumeSection.astro';
import ResumeDialog from './ResumeDialog.astro';
import ContactSection from './ContactSection.astro';
import Navigation from './Navigation.astro';
import { content, workShared } from '../data/content';
import { resume } from '../data/resume';
import type { IconName } from '../lib/icons';
import type { DisciplineId, Lang, SectionId } from '../data/types';
import { site } from '../config/site.config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const r = resume[lang];
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const urls: Record<Lang, string> = { en: `${root}/`, fa: `${root}/fa/` };
const otherLang: Lang = lang === 'fa' ? 'en' : 'fa';
const fmt = (n: number): string => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const src = (path: string): string => (/^(https?:)?\/\//.test(path) ? path : `${root}/${path.replace(/^\//, '')}`);
const works = t.work.map((w) => ({ ...w, ...workShared[w.id] }));
const meta: Record<DisciplineId, { icon: IconName; color: string }> = {
  ux: { icon: 'ux', color: 'var(--fill-ux)' },
  woo: { icon: 'cart', color: 'var(--fill-woo)' },
  content: { icon: 'content', color: 'var(--fill-content)' },
};
const discs = t.disciplines.map((d) => ({ ...d, ...meta[d.id] }));
const navIcons: Record<SectionId, IconName> = { top: 'home', skills: 'layers', process: 'route', work: 'briefcase', resume: 'file', contact: 'mail' };
const ids: SectionId[] = site.sections;
const has = (id: SectionId): boolean => ids.includes(id);
/** One entry per section: the component and its props. Order and visibility come from site.config.ts. */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const registry: Record<SectionId, { Component: any; props: Record<string, unknown> }> = {
  top: { Component: HeroSection, props: { t } },
  skills: { Component: SkillsSection, props: { t, discs } },
  process: { Component: ProcessSection, props: { t, fmt } },
  work: { Component: WorkSection, props: { t, works } },
  resume: { Component: ResumeSection, props: { t, r } },
  contact: { Component: ContactSection, props: { t } },
};
const year = fmt(new Date().getFullYear()).replace(/[,٬]/g, '');
---
<Base lang={lang} title={`${t.name} | ${t.title}`} description={t.description} urls={urls} name={t.name} jobTitle={t.title}>
  <a class="skip" href="#main">{t.ui.skip}</a>
  {site.features.progressBar && <div class="progress" aria-hidden="true"></div>}

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="#top"><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
      <noscript><a class="ns-lang" href={urls[otherLang]}>{lang === 'fa' ? 'English' : 'فارسی'}</a></noscript>
      <button class="menu-btn" type="button" data-open="menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mlabel">{t.ui.menu}</span>
      </button>
    </div>
  </header>

  <Navigation lang={lang} t={t} urls={urls} fmt={fmt} ids={ids} navIcons={navIcons} />

  <main id="main">
    {ids.map((id) => { const { Component, props } = registry[id]; return <Component {...props} />; })}
  </main>

  {has('skills') && <SkillDialogs t={t} discs={discs} works={has('work') ? works : []} fmt={fmt} />}

  {has('work') && <WorkDialogs t={t} works={works} fmt={fmt} src={src} />}

  {has('resume') && <ResumeDialog t={t} r={r} />}

  <footer><div class="wrap foot"><span>© {year} {t.name}</span><a class="topbtn" href="#top"><Icon name="up" size={16} />{t.ui.backTop}</a></div></footer>
</Base>

<script>
  import { initScrollTracking } from '../scripts/scroll-tracking';
  import { initModalController } from '../scripts/modal-controller';
  import { initThemeController } from '../scripts/theme-controller';
  import { initCopyController } from '../scripts/copy-controller';
  import { initDotTips, initRevealAnimations } from '../scripts/visual-effects';
  import { initPerformanceController } from '../scripts/performance-controller';
  import { initPrintController } from '../scripts/print-controller';

  /** Runs one feature in isolation so a failure in one never breaks the others. */
  function run(name: string, init: () => void): void {
    try {
      init();
    } catch (error) {
      console.warn(`[portfolio] ${name} failed`, error);
    }
  }
  const root = document.documentElement;

  /* ---------- scroll and section tracking ---------- */
  run('scroll tracking', initScrollTracking);

  /* ---------- dot labels and reveal animations ---------- */
  run('dots', initDotTips);
  run('reveal', initRevealAnimations);


  /* ---------- modals ---------- */
  initModalController();

  /* ---------- theme switch ---------- */
  run('theme', initThemeController);

  /* ---------- copy email ---------- */
  run('copy', initCopyController);

  /* ---------- resume print / save as PDF ---------- */
  run('print', initPrintController);

  /* ---------- adaptive performance ---------- */
  run('perf', initPerformanceController);

  root.classList.add('ready');
</script>
