---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { content, workShared } from '../data/content';
import { rich } from '../lib/rich';
import type { IconName } from '../lib/icons';
import type { DisciplineId, Lang, SectionId } from '../data/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const urls: Record<Lang, string> = { en: `${root}/`, fa: `${root}/fa/` };
const otherLang: Lang = lang === 'fa' ? 'en' : 'fa';
const fmt = (n: number): string => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const src = (path: string): string => (/^(https?:)?\/\//.test(path) ? path : `${root}/${path.replace(/^\//, '')}`);
const works = t.work.map((w) => ({ ...w, ...workShared[w.id] }));
const meta: Record<DisciplineId, { icon: IconName; color: string }> = {
  ux: { icon: 'ux', color: '#2447f5' },
  woo: { icon: 'cart', color: '#6d33e0' },
  content: { icon: 'content', color: '#0b8a7b' },
};
const discs = t.disciplines.map((d) => ({ ...d, ...meta[d.id] }));
const navIcons: Record<SectionId, IconName> = { top: 'home', skills: 'layers', process: 'route', work: 'briefcase', resume: 'file', contact: 'mail' };
const ids: SectionId[] = ['top', 'skills', 'process', 'work', 'resume', 'contact'];
const stepIcons: IconName[] = ['search', 'target', 'pen', 'code', 'trend'];
const roleIcons: IconName[] = ['ux', 'cart', 'content'];
const roleClasses = ['r-ux', 'r-woo', 'r-content'];
const year = fmt(new Date().getFullYear()).replace(/[,٬]/g, '');
const arrow = '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base lang={lang} title={`${t.name} | ${t.title}`} description={t.description} urls={urls} name={t.name} jobTitle={t.title}>
  <a class="skip" href="#main">{t.ui.skip}</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="#top"><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
      <noscript><a class="ns-lang" href={urls[otherLang]}>{lang === 'fa' ? 'English' : 'فارسی'}</a></noscript>
      <button class="menu-btn" type="button" data-open="menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mlabel">{t.ui.menu}</span>
      </button>
    </div>
  </header>

  <nav class="dots" aria-label={t.ui.sections}>
    <ol>
      {ids.map((id, i) => (
        <li><a href={`#${id}`} aria-current={i === 0 ? 'true' : undefined}><span class="lab"><Icon name={navIcons[id]} size={14} />{t.ui.nav[id]}</span><span class="pip"></span></a></li>
      ))}
    </ol>
  </nav>

  <main id="main">
    <section class="hero" id="top" tabindex="-1" data-section>
      <div class="wrap hero-grid">
        <div class="hero-text">
          <h1>
            {t.hero.map((p, i) => (
              <Fragment><span class:list={['w', { mark: p.mark }]} style={`--i:${i}`}>{p.t}</span>{' '}</Fragment>
            ))}
          </h1>
          <p class="lead" set:html={rich(t.intro)} />
          <ul class="roles">
            {t.roles.map((r, i) => <li><a href={r.href} class={roleClasses[i]}><Icon name={roleIcons[i]} size={18} />{r.label}</a></li>)}
          </ul>
          <div class="btns">
            <a class="btn primary" href="#work"><span>{t.ui.ctaWork}</span><span class="arr" set:html={arrow} /></a>
            <a class="btn" href={`mailto:${t.email}`}><Icon name="mail" size={18} />{t.ui.ctaMail}</a>
          </div>
        </div>
        <svg class="art" viewBox="0 0 420 360" aria-hidden="true" focusable="false">
          <g transform="translate(8 10)"><g class="card" style="--i:0">
            <rect class="surf" x="0" y="0" width="240" height="172" rx="16"/>
            <circle cx="20" cy="18" r="4" class="dim"/><circle cx="34" cy="18" r="4" class="dim"/><circle cx="48" cy="18" r="4" class="dim"/>
            <rect x="16" y="38" width="100" height="70" rx="8" class="tint"/>
            <path d="M16 38l100 70M116 38L16 108" class="wire"/>
            <rect x="132" y="42" width="90" height="8" rx="4" class="dim"/><rect x="132" y="58" width="68" height="8" rx="4" class="dim"/><rect x="132" y="74" width="80" height="8" rx="4" class="dim"/>
            <rect x="132" y="92" width="58" height="18" rx="9" class="acc"/>
            <rect x="16" y="124" width="64" height="34" rx="8" class="wire-box"/><rect x="88" y="124" width="64" height="34" rx="8" class="wire-box"/><rect x="160" y="124" width="64" height="34" rx="8" class="wire-box"/>
            <path d="M240 24l16-10M240 24l14 14" class="wire"/><circle cx="240" cy="24" r="5" class="acc"/><rect x="252" y="8" width="9" height="9" class="surf wire-box"/>
          </g></g>
          <g transform="translate(150 96)"><g class="card" style="--i:1">
            <rect class="panel" x="0" y="0" width="250" height="168" rx="16"/>
            <path d="M26 34l-12 10 12 10M62 34l12 10-12 10M48 28l-8 32" class="code-line"/>
            <rect x="96" y="30" width="60" height="7" rx="3.5" class="c-a"/><rect x="164" y="30" width="44" height="7" rx="3.5" class="c-b"/>
            <rect x="96" y="46" width="30" height="7" rx="3.5" class="c-b"/><rect x="134" y="46" width="80" height="7" rx="3.5" class="c-c"/>
            <rect x="28" y="76" width="70" height="7" rx="3.5" class="c-c"/><rect x="106" y="76" width="52" height="7" rx="3.5" class="c-a"/>
            <rect x="44" y="92" width="96" height="7" rx="3.5" class="c-b"/><rect x="148" y="92" width="40" height="7" rx="3.5" class="c-c"/>
            <rect x="28" y="108" width="54" height="7" rx="3.5" class="c-a"/>
            <circle cx="214" cy="132" r="22" class="acc"/>
            <g transform="translate(202 120)" class="cart-ic"><circle cx="7" cy="19" r="1.6"/><circle cx="17" cy="19" r="1.6"/><path d="M1 3h3l2.2 11h11l1.8-7H5"/></g>
          </g></g>
          <g transform="translate(34 204)"><g class="card" style="--i:2">
            <rect class="surf" x="0" y="0" width="214" height="126" rx="16"/>
            <rect x="18" y="26" width="76" height="9" rx="4.5" class="hl"/><rect x="18" y="18" width="128" height="12" rx="6" class="ink"/>
            <rect x="18" y="46" width="176" height="7" rx="3.5" class="dim"/><rect x="18" y="60" width="150" height="7" rx="3.5" class="dim"/><rect x="18" y="74" width="112" height="7" rx="3.5" class="dim"/>
            <rect x="18" y="96" width="46" height="16" rx="8" class="tint"/><rect x="72" y="96" width="56" height="16" rx="8" class="tint"/>
            <path d="M176 100l6-12h-6v-8h12v8l-6 12z" class="acc"/>
          </g></g>
        </svg>
      </div>
    </section>

    <section id="skills" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="layers" size={24} /></span><h2>{t.skillsHead}</h2></div>
      <p class="sub" data-reveal style="--d:1">{t.title}.</p>
      {discs.map((d, k) => (
        <article class={`disc d-${d.id}`} id={d.id} data-reveal>
          <div class="disc-main">
            <span class="tile lg sub" style={`--k:${k}`}><Icon name={d.icon} size={28} /></span>
            <h3>{d.name}</h3>
            <p set:html={rich(d.summary)} />
            <button class="more" type="button" data-open={`skill-${d.id}`} aria-haspopup="dialog"><span>{t.ui.explore}</span><Icon name="arrow" size={18} /><span class="sr"> — {d.name}</span></button>
          </div>
          <div class="tree">
            <ul class="branches" data-stagger>
              {d.groups.map((g, gi) => (
                <li class:list={['branch', { ai: g.ai }]} style={`--k:${gi}`}>
                  <h4 class="b-title"><span class="tile xs sub" style={`--k:${gi}`}><Icon name={g.icon} size={14} /></span>{g.title}</h4>
                  <ul class="leaves">
                    {g.items.map((s) => <li set:html={rich(s)} />)}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div></section>

    <section id="process" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="route" size={24} /></span><h2>{t.processHead}</h2></div>
      <p class="sub" data-reveal style="--d:1" set:html={rich(t.processSub)} />
      <ol class="steps" data-steps>
        {t.process.map((p, i) => (
          <li style={`--i:${i};--d:${i}`} data-reveal>
            <span class="num" aria-hidden="true"><span class="tile sm sub" style={`--k:${i}`}><Icon name={stepIcons[i]} size={18} /></span></span>
            <strong><span class="n">{fmt(i + 1)}</span> {p.step}</strong>
            <span class="txt">{p.text}</span>
          </li>
        ))}
      </ol>
    </div></section>

    <section id="work" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="briefcase" size={24} /></span><h2>{t.workHead}</h2></div>
      <p class="sub" data-reveal style="--d:1">{t.workSub}</p>
      <div class="cases">
        {works.map((w, i) => (
          <div class="case-wrap" data-reveal style={`--d:${i}`}>
            <article class="case" style={`--c:${w.color}`}>
              <div class="case-head">
                <Logo w={w} />
                <div><h3>{w.title}</h3><p class="client">{w.client} · {w.year}</p></div>
              </div>
              <ul class="tags">{w.roles.map((r) => <li>{r}</li>)}</ul>
              <p class="case-sum" set:html={rich(w.summary)} />
              <button class="open" type="button" data-open={`case-${w.id}`} aria-haspopup="dialog"><span>{t.ui.viewCase}</span><Icon name="arrow" size={18} /><span class="sr"> — {w.title}</span></button>
            </article>
          </div>
        ))}
      </div>
    </div></section>

    <section id="resume" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="file" size={24} /></span><h2>{t.resumeHead}</h2></div>
      <ul class="xp">
        {t.experience.map((e, i) => (
          <li data-reveal style={`--d:${i};--k:${i}`}><span class="dot"><Icon name="briefcase" size={14} /></span><span class="when">{e.period}</span><span><strong>{e.role}</strong><br />{e.org}</span></li>
        ))}
      </ul>
    </div></section>

    <section id="contact" class="contact" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="mail" size={24} /></span><h2>{t.contactHead}</h2></div>
      <p class="sub" data-reveal style="--d:1">{t.contactSub}</p>
      <div class="mailrow" data-reveal style="--d:2">
        <a class="mail" dir="ltr" href={`mailto:${t.email}`}>{t.email}</a>
        <button class="btn copy" type="button" data-copy={t.email} data-done={t.ui.copied}>
          <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15V6a2 2 0 012-2h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="i-check" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="txt" aria-live="polite">{t.ui.copy}</span>
        </button>
      </div>
      <ul class="links" data-reveal style="--d:3">
        {t.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}<Icon name="external" size={15} /></a></li>)}
      </ul>
    </div></section>
  </main>

  <dialog class="menu-dlg" id="menu" aria-label={t.ui.menuTitle}>
    <div class="menu-in">
      <div class="menu-top">
        <a class="brand" href="#top" data-nav><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
        <button class="x" type="button" data-close aria-label={t.ui.menuClose}><Icon name="x" size={20} /></button>
      </div>
      <nav aria-label={t.ui.menuTitle}>
        <ol class="menu-nav">
          {ids.map((id, i) => (
            <li style={`--k:${i}`}><a href={`#${id}`} data-nav><span class="mn" aria-hidden="true">{fmt(i + 1)}</span><span class="tile sm"><Icon name={navIcons[id]} size={18} /></span><span class="ml">{t.ui.nav[id]}</span><Icon name="arrow" size={18} class="mar" /></a></li>
          ))}
        </ol>
      </nav>
      <div class="menu-set">
        <div class="set-row">
          <span class="set-l"><Icon name="globe" size={18} />{t.ui.langLabel}</span>
          <nav class="lang" dir="ltr" aria-label={t.ui.langLabel} data-active={lang}>
            <a href={urls.en} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
            <a href={urls.fa} lang="fa" hreflang="fa" aria-current={lang === 'fa' ? 'true' : undefined} aria-label="فارسی">FA</a>
          </nav>
        </div>
        <div class="set-row">
          <span class="set-l" id="theme-l"><Icon name="moon" size={18} />{t.ui.themeLabel}</span>
          <button class="switch" type="button" role="switch" aria-checked="false" aria-labelledby="theme-l" data-theme-toggle>
            <span class="knob"><Icon name="sun" size={14} class="k-sun" /><Icon name="moon" size={14} class="k-moon" /></span>
          </button>
        </div>
      </div>
      <div class="menu-cta">
        <a class="btn primary" href={`mailto:${t.email}`}><Icon name="mail" size={18} />{t.ui.ctaMail}</a>
      </div>
    </div>
  </dialog>

  {discs.map((d) => (
    <dialog class="case-dlg skill-dlg" id={`skill-${d.id}`} aria-labelledby={`skill-${d.id}-t`} style={`--c:${d.color}`}>
      <div class="dlg-bar">
        <div class="dlg-id"><span class="tile sm"><Icon name={d.icon} size={18} /></span><span>{d.name}</span></div>
        <button class="x" type="button" data-close aria-label={t.ui.close}><Icon name="x" size={20} /></button>
      </div>
      <div class="cover" aria-hidden="true">
        <svg viewBox="0 0 400 140" preserveAspectRatio="xMidYMid slice"><defs><pattern id={`gs-${d.id}`} width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#fff" stroke-opacity=".18"/></pattern></defs><rect width="400" height="140" fill={`url(#gs-${d.id})`}/></svg>
        <span class="cover-ic"><Icon name={d.icon} size={56} /></span>
      </div>
      <div class="dlg-body">
        <header class="dlg-head">
          <h2 id={`skill-${d.id}-t`}>{d.name}</h2>
          <p set:html={rich(d.summary)} />
        </header>
        <div class="dlg-grid">
          <aside class="dlg-side">
            <dl class="facts">
              <div><dt><Icon name="tools" size={16} />{t.ui.toolkit}</dt><dd><ul class="chips sm">{d.detail.tools.map((x) => <li>{x}</li>)}</ul></dd></div>
            </dl>
            {d.detail.related.length > 0 && (
              <div class="rel">
                <h3><Icon name="briefcase" size={16} />{t.ui.related}</h3>
                <ul>
                  {d.detail.related.map((rid) => {
                    const w = works.find((x) => x.id === rid);
                    return w && <li><button type="button" class="rel-btn" data-open={`case-${w.id}`} aria-haspopup="dialog"><Logo w={w} size="sm" /><span>{w.title}</span><Icon name="arrow" size={16} /></button></li>;
                  })}
                </ul>
              </div>
            )}
            <a class="btn primary wide" href={`mailto:${t.email}?subject=${encodeURIComponent(d.name)}`}><Icon name="mail" size={18} /><span>{t.ui.talk}</span></a>
          </aside>
          <div class="dlg-main">
            <section class="blk"><h3><span class="tile sm"><Icon name="bulb" size={18} /></span>{t.ui.overview}</h3><p set:html={rich(d.detail.overview)} /></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="check" size={18} /></span>{t.ui.deliver}</h3>
              <ul class="goals">{d.detail.deliverables.map((x) => <li><Icon name="check" size={18} /><span set:html={rich(x)} /></li>)}</ul></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="route" size={18} /></span>{t.ui.approach}</h3>
              <ol class="mini-steps">{d.detail.approach.map((p, i) => <li><span class="n">{fmt(i + 1)}</span><div><strong>{p.title}</strong><span>{p.text}</span></div></li>)}</ol></section>
            <section class="blk ai-box"><h3><span class="tile sm"><Icon name="spark" size={18} /></span>{d.detail.ai.title}</h3>
              <p set:html={rich(d.detail.ai.text)} />
              <ul class="ai-points">{d.detail.ai.points.map((x) => <li><Icon name="spark" size={14} />{x}</li>)}</ul></section>
          </div>
        </div>
      </div>
    </dialog>
  ))}

  {works.map((w) => (
    <dialog class="case-dlg" id={`case-${w.id}`} aria-labelledby={`case-${w.id}-t`} style={`--c:${w.color}`}>
      <div class="dlg-bar">
        <div class="dlg-id"><Logo w={w} size="sm" /><span>{w.client}</span></div>
        <button class="x" type="button" data-close aria-label={t.ui.close}><Icon name="x" size={20} /></button>
      </div>
      <div class="cover" aria-hidden="true">
        <svg viewBox="0 0 400 140" preserveAspectRatio="xMidYMid slice"><defs><pattern id={`g-${w.id}`} width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#fff" stroke-opacity=".18"/></pattern></defs><rect width="400" height="140" fill={`url(#g-${w.id})`}/></svg>
        {w.cover && <img src={src(w.cover)} alt="" loading="lazy" onerror="this.remove()" />}
      </div>
      <div class="dlg-body">
        <header class="dlg-head">
          <h2 id={`case-${w.id}-t`}>{w.title}</h2>
          <p set:html={rich(w.summary)} />
          <ul class="tags">{w.roles.map((r) => <li>{r}</li>)}</ul>
        </header>
        <div class="dlg-grid">
          <aside class="dlg-side">
            <dl class="facts">
              <div><dt><Icon name="briefcase" size={16} />{t.ui.client}</dt><dd>{w.client}</dd></div>
              <div><dt><Icon name="calendar" size={16} />{t.ui.year}</dt><dd>{w.year}</dd></div>
              <div><dt><Icon name="clock" size={16} />{t.ui.duration}</dt><dd>{w.duration}</dd></div>
              <div><dt><Icon name="user" size={16} />{t.ui.team}</dt><dd>{w.team}</dd></div>
              {w.tools?.length > 0 && <div><dt><Icon name="tools" size={16} />{t.ui.tools}</dt><dd><ul class="chips sm">{w.tools.map((x) => <li>{x}</li>)}</ul></dd></div>}
            </dl>
            {w.url && <a class="btn primary wide" href={w.url} rel="noopener" target="_blank"><span>{t.ui.visit}</span><Icon name="external" size={18} /></a>}
          </aside>
          <div class="dlg-main">
            <section class="blk"><h3><span class="tile sm"><Icon name="bulb" size={18} /></span>{t.ui.overview}</h3><p set:html={rich(w.overview)} /></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="flag" size={18} /></span>{t.ui.challenge}</h3><p set:html={rich(w.challenge)} /></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="target" size={18} /></span>{t.ui.goals}</h3>
              <ul class="goals">{w.goals.map((g) => <li><Icon name="check" size={18} /><span set:html={rich(g)} /></li>)}</ul></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="pen" size={18} /></span>{t.ui.myRole}</h3><p set:html={rich(w.role)} /></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="route" size={18} /></span>{t.ui.process}</h3>
              <ol class="mini-steps">{w.process.map((p, i) => <li><span class="n">{fmt(i + 1)}</span><div><strong>{p.title}</strong><span set:html={rich(p.text)} /></div></li>)}</ol></section>
            <section class="blk"><h3><span class="tile sm"><Icon name="layers" size={18} /></span>{t.ui.solution}</h3><p set:html={rich(w.solution)} /></section>
            {w.results?.length > 0 && <section class="blk"><h3><span class="tile sm"><Icon name="trend" size={18} /></span>{t.ui.results}</h3>
              <ul class="kpis">{w.results.map((r) => <li><b>{r.value}</b><span>{r.label}</span></li>)}</ul></section>}
            <section class="blk"><h3><span class="tile sm"><Icon name="image" size={18} /></span>{t.ui.gallery}</h3>
              <ul class="gallery">
                {w.gallery?.length > 0
                  ? w.gallery.map((g, i) => <li><img src={src(g)} alt={`${w.title} — ${t.ui.shot} ${fmt(i + 1)}`} loading="lazy" /></li>)
                  : [1, 2, 3].map(() => <li class="ph" aria-hidden="true"><Icon name="image" size={28} /><span>{t.ui.shot}</span></li>)}
              </ul></section>
            {w.testimonial && <figure class="quote"><Icon name="quote" size={28} /><blockquote>{w.testimonial.quote}</blockquote><figcaption><b>{w.testimonial.author}</b> · {w.testimonial.title}</figcaption></figure>}
          </div>
        </div>
      </div>
    </dialog>
  ))}

  <footer><div class="wrap foot"><span>© {year} {t.name}</span><a class="topbtn" href="#top"><Icon name="up" size={16} />{t.ui.backTop}</a></div></footer>
</Base>

<script>
  /* ---------- tiny typed DOM helpers ---------- */
  function $<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T | null {
    return scope.querySelector<T>(selector);
  }
  function $$<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T[] {
    return Array.from(scope.querySelectorAll<T>(selector));
  }
  const getDialog = (id: string): HTMLDialogElement | null => {
    const el = document.getElementById(id);
    return el instanceof HTMLDialogElement ? el : null;
  };

  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- scroll progress, header state, section activation ---------- */
  const bar = $('.bar');
  const progress = $('.progress');
  const hero = $('#top');
  const dots = $$<HTMLAnchorElement>('.dots a');
  const menuLinks = $$<HTMLAnchorElement>('.menu-nav a');
  const sections = $$('[data-section]');
  const steps = $('[data-steps]');
  const stepItems = steps ? $$('li', steps) : [];

  function activate(id: string): void {
    const href = `#${id}`;
    for (const link of [...dots, ...menuLinks]) {
      if (link.getAttribute('href') === href) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    for (const section of sections) section.classList.toggle('is-active', section.id === id);
  }

  function updateStepProgress(): void {
    if (!steps) return;
    const rect = steps.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = Math.min(1, Math.max(0, (vh * 0.82 - rect.top) / (rect.height + vh * 0.3)));
    steps.style.setProperty('--p', p.toFixed(3));
    stepItems.forEach((item, i) => item.classList.toggle('done', p > 0.02 && p * 4 >= i - 0.001));
  }

  let scrollQueued = false;
  function onScroll(): void {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      const max = root.scrollHeight - window.innerHeight;
      progress?.style.setProperty('--p', String(max > 0 ? Math.min(y / max, 1) : 0));
      bar?.classList.toggle('scrolled', y > 8);
      const last = sections.at(-1);
      if (last && max > 0 && max - y < 4) activate(last.id);
      updateStepProgress();
      scrollQueued = false;
    });
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();

  const sectionObserver = new IntersectionObserver(
    (entries) => entries.forEach((entry) => entry.isIntersecting && activate(entry.target.id)),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => sectionObserver.observe(section));

  /* ---------- dot labels: also show on tap (touch has no hover) ---------- */
  const tipTimers = new WeakMap<HTMLElement, number>();
  function showTip(link: HTMLElement): void {
    link.classList.add('tip');
    window.clearTimeout(tipTimers.get(link));
    tipTimers.set(link, window.setTimeout(() => link.classList.remove('tip'), 2200));
  }
  dots.forEach((link) => {
    link.addEventListener('pointerdown', (event) => event.pointerType !== 'mouse' && showTip(link));
    link.addEventListener('click', () => showTip(link));
  });

  /* ---------- repeating reveal animations ---------- */
  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach((entry) => entry.target.classList.toggle('in', entry.isIntersecting)),
    { rootMargin: '0px 0px -8% 0px' },
  );
  $$('[data-reveal], [data-stagger]').forEach((el) => revealObserver.observe(el));
  if (hero) {
    new IntersectionObserver(
      (entries) => entries.forEach((entry) => hero.classList.toggle('run', entry.isIntersecting)),
      { threshold: 0 },
    ).observe(hero);
  }

  /* ---------- modal manager (history entry so the Back button closes a modal) ---------- */
  interface ModalState { modal: string }
  let openDialog: HTMLDialogElement | null = null;
  const menuButtons = $$('[data-open="menu"]');
  const setMenuExpanded = (open: boolean): void => menuButtons.forEach((b) => b.setAttribute('aria-expanded', String(open)));

  function openModal(id: string): void {
    const dialog = getDialog(id);
    if (!dialog) return;
    let replace = false;
    if (openDialog && openDialog !== dialog) {
      const previous = openDialog;
      openDialog = null;
      previous.close();
      replace = true;
    }
    dialog.showModal();
    dialog.scrollTop = 0;
    openDialog = dialog;
    if (id === 'menu') {
      const current = dots.find((link) => link.getAttribute('aria-current') === 'true');
      if (current) activate(current.hash.slice(1));
      setMenuExpanded(true);
    }
    const state: ModalState = { modal: id };
    if (replace) history.replaceState(state, '');
    else history.pushState(state, '');
  }

  function closeSilently(dialog: HTMLDialogElement): void {
    if (openDialog === dialog) openDialog = null;
    dialog.close();
  }

  $$('[data-open]').forEach((button) =>
    button.addEventListener('click', () => {
      const id = button.dataset.open;
      if (id) openModal(id);
    }),
  );

  $$<HTMLDialogElement>('dialog').forEach((dialog) => {
    $('[data-close]', dialog)?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (dialog.id === 'menu') setMenuExpanded(false);
      if (openDialog !== dialog) return;
      openDialog = null;
      const state = history.state as Partial<ModalState> | null;
      if (state?.modal) history.back();
    });
  });
  addEventListener('popstate', () => {
    if (!openDialog) return;
    const dialog = openDialog;
    openDialog = null;
    dialog.close();
  });

  // menu links: close the menu, scroll to the section, move focus there
  const menuDialog = getDialog('menu');
  $$<HTMLAnchorElement>('[data-nav]').forEach((link) =>
    link.addEventListener('click', (event) => {
      const hash = link.getAttribute('href');
      const target = hash ? $(hash) : null;
      if (!hash || !target) return;
      event.preventDefault();
      if (menuDialog) closeSilently(menuDialog);
      history.replaceState(null, '', hash);
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
        target.focus({ preventScroll: true });
      });
    }),
  );

  /* ---------- theme switch ---------- */
  const themeSwitch = $('[data-theme-toggle]');
  const readStoredTheme = (): string | null => {
    try { return localStorage.getItem('theme'); } catch { return null; }
  };
  const syncSwitch = (): void => themeSwitch?.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
  syncSwitch();
  themeSwitch?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* storage unavailable */ }
    syncSwitch();
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (readStoredTheme()) return;
    root.dataset.theme = event.matches ? 'dark' : 'light';
    syncSwitch();
  });

  /* ---------- copy email ---------- */
  function selectText(el: Element): void {
    const range = document.createRange();
    range.selectNodeContents(el);
    const selection = getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }
  $$('[data-copy]').forEach((button) => {
    const label = $('.txt', button);
    if (!label) return;
    const original = label.textContent ?? '';
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        const mail = $('.mail');
        if (mail) selectText(mail); // clipboard blocked: select the address so it can be copied by hand
      }
      button.classList.add('done');
      label.textContent = button.dataset.done ?? original;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('done');
        label.textContent = original;
      }, 1800);
    });
  });
</script>
