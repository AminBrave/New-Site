---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SkillDialogs from './SkillDialogs.astro';
import WorkDialogs from './WorkDialogs.astro';
import HeroSection from './HeroSection.astro';
import SkillsSection from './SkillsSection.astro';
import ProcessSection from './ProcessSection.astro';
import WorkSection from './WorkSection.astro';
import ResumeSection from './ResumeSection.astro';
import ContactSection from './ContactSection.astro';
import { content, workShared } from '../data/content';
import type { IconName } from '../lib/icons';
import type { DisciplineId, Lang, SectionId } from '../data/types';

interface Props {
  lang: Lang;
  preload?: string[];
}

const { lang, preload } = Astro.props;
const t = content[lang];
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const urls: Record<Lang, string> = { en: `${root}/`, fa: `${root}/fa/` };
const otherLang: Lang = lang === 'fa' ? 'en' : 'fa';
const fmt = (n: number): string => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
const src = (path: string): string => (/^(https?:)?\/\//.test(path) ? path : `${root}/${path.replace(/^\//, '')}`);
const works = t.work.map((w) => ({ ...w, ...workShared[w.id] }));
const meta: Record<DisciplineId, { icon: IconName; color: string }> = {
  ux: { icon: 'ux', color: '#2447f5' },
  woo: { icon: 'cart', color: '#6d33e0' },
  content: { icon: 'content', color: '#0b8a7b' },
};
const discs = t.disciplines.map((d) => ({ ...d, ...meta[d.id] }));
const navIcons: Record<SectionId, IconName> = { top: 'home', skills: 'layers', process: 'route', work: 'briefcase', resume: 'file', contact: 'mail' };
const ids: SectionId[] = ['top', 'skills', 'process', 'work', 'resume', 'contact'];
const year = fmt(new Date().getFullYear()).replace(/[,٬]/g, '');
---
<Base lang={lang} title={`${t.name} | ${t.title}`} description={t.description} urls={urls} name={t.name} jobTitle={t.title} preload={preload}>
  <a class="skip" href="#main">{t.ui.skip}</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href="#top"><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
      <noscript><a class="ns-lang" href={urls[otherLang]}>{lang === 'fa' ? 'English' : 'فارسی'}</a></noscript>
      <button class="menu-btn" type="button" data-open="menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mlabel">{t.ui.menu}</span>
      </button>
    </div>
  </header>

  <nav class="dots" aria-label={t.ui.sections}>
    <ol>
      {ids.map((id, i) => (
        <li><a href={`#${id}`} aria-current={i === 0 ? 'true' : undefined}><span class="lab"><Icon name={navIcons[id]} size={14} />{t.ui.nav[id]}</span><span class="pip"></span></a></li>
      ))}
    </ol>
  </nav>

  <main id="main">
    <HeroSection t={t} />

    <SkillsSection t={t} discs={discs} />

    <ProcessSection t={t} fmt={fmt} />

    <WorkSection t={t} works={works} />

    <ResumeSection t={t} />

    <ContactSection t={t} />

  </main>

  <dialog class="menu-dlg" id="menu" aria-label={t.ui.menuTitle}>
    <div class="menu-in">
      <div class="menu-top">
        <a class="brand" href="#top" data-nav><span class="logo" aria-hidden="true"></span><span class="bname">{t.name}</span></a>
        <button class="x" type="button" data-close aria-label={t.ui.menuClose}><Icon name="x" size={20} /></button>
      </div>
      <nav aria-label={t.ui.menuTitle}>
        <ol class="menu-nav">
          {ids.map((id, i) => (
            <li style={`--k:${i}`}><a href={`#${id}`} data-nav><span class="mn" aria-hidden="true">{fmt(i + 1)}</span><span class="tile sm"><Icon name={navIcons[id]} size={18} /></span><span class="ml">{t.ui.nav[id]}</span><Icon name="arrow" size={18} class="mar" /></a></li>
          ))}
        </ol>
      </nav>
      <div class="menu-set">
        <div class="set-row">
          <span class="set-l"><Icon name="globe" size={18} />{t.ui.langLabel}</span>
          <nav class="lang" dir="ltr" aria-label={t.ui.langLabel} data-active={lang}>
            <a href={urls.en} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
            <a href={urls.fa} lang="fa" hreflang="fa" aria-current={lang === 'fa' ? 'true' : undefined} aria-label="فارسی">FA</a>
          </nav>
        </div>
        <div class="set-row">
          <span class="set-l" id="theme-l"><Icon name="moon" size={18} />{t.ui.themeLabel}</span>
          <button class="switch" type="button" role="switch" aria-checked="false" aria-labelledby="theme-l" data-theme-toggle>
            <span class="knob"><Icon name="sun" size={14} class="k-sun" /><Icon name="moon" size={14} class="k-moon" /></span>
          </button>
        </div>
      </div>
      <div class="menu-cta">
        <a class="btn primary" href={`mailto:${t.email}`}><Icon name="mail" size={18} />{t.ui.ctaMail}</a>
      </div>
    </div>
  </dialog>

  <SkillDialogs t={t} discs={discs} works={works} fmt={fmt} />

  <WorkDialogs t={t} works={works} fmt={fmt} src={src} />

  <footer><div class="wrap foot"><span>© {year} {t.name}</span><a class="topbtn" href="#top"><Icon name="up" size={16} />{t.ui.backTop}</a></div></footer>
</Base>

<script>
  /* ---------- helpers ---------- */
  function $<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T | null {
    return scope.querySelector<T>(selector);
  }
  function $$<T extends HTMLElement = HTMLElement>(selector: string, scope: ParentNode = document): T[] {
    return Array.from(scope.querySelectorAll<T>(selector));
  }
  /** Runs one feature in isolation so a failure in one never breaks the others. */
  function run(name: string, init: () => void): void {
    try {
      init();
    } catch (error) {
      console.warn(`[portfolio] ${name} failed`, error);
    }
  }
  const getDialog = (id: string): HTMLDialogElement | null => {
    const el = document.getElementById(id);
    return el && el.localName === 'dialog' ? (el as HTMLDialogElement) : null;
  };

  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasObserver = 'IntersectionObserver' in window;

  const bar = $('.bar');
  const progress = $('.progress');
  const hero = $('#top');
  const dots = $$<HTMLAnchorElement>('.dots a');
  const menuLinks = $$<HTMLAnchorElement>('.menu-nav a');
  const sections = $$('[data-section]');
  const steps = $('[data-steps]');
  const stepItems = steps ? $$('li', steps) : [];

  /* ---------- active section, scroll progress, step bar ---------- */
  function activate(id: string): void {
    const href = `#${id}`;
    for (const link of [...dots, ...menuLinks]) {
      if (link.getAttribute('href') === href) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    for (const section of sections) section.classList.toggle('is-active', section.id === id);
  }

  let stepsNear = !hasObserver;
  function updateStepProgress(): void {
    if (!steps || !stepsNear) return; // skip layout reads while the steps are far off-screen
    const rect = steps.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = Math.min(1, Math.max(0, (vh * 0.82 - rect.top) / (rect.height + vh * 0.3)));
    steps.style.setProperty('--p', p.toFixed(3));
    stepItems.forEach((item, i) => item.classList.toggle('done', p > 0.02 && p * 4 >= i - 0.001));
  }

  /** Fallback for browsers without IntersectionObserver. */
  function activateFromScroll(): void {
    const middle = window.innerHeight / 2;
    const hit = sections.find((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= middle && r.bottom > middle;
    });
    if (hit) activate(hit.id);
  }

  let scrollQueued = false;
  function onScroll(): void {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      const max = root.scrollHeight - window.innerHeight;
      progress?.style.setProperty('--p', String(max > 0 ? Math.min(y / max, 1) : 0));
      bar?.classList.toggle('scrolled', y > 8);
      if (!hasObserver) activateFromScroll();
      const last = sections[sections.length - 1];
      if (last && max > 0 && max - y < 4) activate(last.id);
      updateStepProgress();
      scrollQueued = false;
    });
  }

  run('scroll', () => {
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();
  });

  run('sections', () => {
    if (!hasObserver) return;
    const sectionObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting && activate(entry.target.id)),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => sectionObserver.observe(section));
    if (steps) {
      new IntersectionObserver(
        (entries) => {
          stepsNear = entries.some((entry) => entry.isIntersecting);
          if (stepsNear) onScroll();
        },
        { rootMargin: '25% 0px' },
      ).observe(steps);
    }
  });

  /* ---------- dot labels: also show on tap (touch has no hover) ---------- */
  run('dots', () => {
    const timers = new WeakMap<HTMLElement, number>();
    const showTip = (link: HTMLElement): void => {
      link.classList.add('tip');
      window.clearTimeout(timers.get(link));
      timers.set(link, window.setTimeout(() => link.classList.remove('tip'), 2200));
    };
    dots.forEach((link) => {
      link.addEventListener('pointerdown', (event) => event.pointerType !== 'mouse' && showTip(link));
      link.addEventListener('click', () => showTip(link));
    });
  });

  /* ---------- repeating reveal animations ---------- */
  run('reveal', () => {
    if (!hasObserver) return;
    const revealObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.target.classList.toggle('in', entry.isIntersecting)),
      { rootMargin: '0px 0px -8% 0px' },
    );
    $$('[data-reveal], [data-stagger]').forEach((el) => revealObserver.observe(el));
    if (hero) {
      new IntersectionObserver(
        (entries) => entries.forEach((entry) => hero.classList.toggle('run', entry.isIntersecting)),
        { threshold: 0 },
      ).observe(hero);
    }
  });

  /* ---------- modals: native <dialog>, with a fallback for browsers without showModal ---------- */
  interface ModalState { modal: string }
  const supportsDialog = typeof HTMLDialogElement === 'function' && typeof HTMLDialogElement.prototype.showModal === 'function';
  let openDialog: HTMLDialogElement | null = null;
  let legacyBackdrop: HTMLDivElement | null = null;
  let legacyReturnFocus: HTMLElement | null = null;
  const menuButtons = $$('[data-open="menu"]');
  const setMenuExpanded = (open: boolean): void => menuButtons.forEach((b) => b.setAttribute('aria-expanded', String(open)));

  function showDialog(dialog: HTMLDialogElement): void {
    root.classList.add('modal-open');
    if (supportsDialog) {
      dialog.showModal();
      return;
    }
    legacyReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (!legacyBackdrop) {
      legacyBackdrop = document.createElement('div');
      legacyBackdrop.className = 'legacy-backdrop';
      legacyBackdrop.addEventListener('click', () => openDialog && hideDialog(openDialog));
      document.body.appendChild(legacyBackdrop);
    }
    legacyBackdrop.hidden = false;
    dialog.classList.add('legacy');
    dialog.setAttribute('open', '');
    dialog.setAttribute('role', 'dialog');
    dialog.setAttribute('aria-modal', 'true');
    $('[data-close]', dialog)?.focus();
  }

  function hideDialog(dialog: HTMLDialogElement): void {
    if (supportsDialog) {
      dialog.close();
      return;
    }
    dialog.removeAttribute('open');
    dialog.classList.remove('legacy');
    if (legacyBackdrop) legacyBackdrop.hidden = true;
    legacyReturnFocus?.focus();
    dialog.dispatchEvent(new Event('close'));
  }

  function openModal(id: string): void {
    const dialog = getDialog(id);
    if (!dialog) return;
    let replace = false;
    if (openDialog && openDialog !== dialog) {
      const previous = openDialog;
      openDialog = null;
      hideDialog(previous);
      replace = true;
    }
    showDialog(dialog);
    dialog.scrollTop = 0;
    openDialog = dialog;
    if (id === 'menu') {
      const current = dots.find((link) => link.getAttribute('aria-current') === 'true');
      if (current) activate(current.hash.slice(1));
      setMenuExpanded(true);
    }
    const state: ModalState = { modal: id };
    if (replace) history.replaceState(state, '');
    else history.pushState(state, '');
  }

  function closeSilently(dialog: HTMLDialogElement): void {
    if (openDialog === dialog) openDialog = null;
    root.classList.remove('modal-open');
    hideDialog(dialog);
  }

  run('modals', () => {
    $$('[data-open]').forEach((button) =>
      button.addEventListener('click', () => {
        const id = button.dataset.open;
        if (id) openModal(id);
      }),
    );
    $$<HTMLDialogElement>('dialog').forEach((dialog) => {
      $('[data-close]', dialog)?.addEventListener('click', () => hideDialog(dialog));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) hideDialog(dialog);
      });
      dialog.addEventListener('close', () => {
        if (dialog.id === 'menu') setMenuExpanded(false);
        root.classList.toggle('modal-open', openDialog !== null && openDialog !== dialog);
        if (openDialog !== dialog) return;
        openDialog = null;
        const state = history.state as Partial<ModalState> | null;
        if (state?.modal) history.back();
      });
    });
    addEventListener('popstate', () => {
      if (!openDialog) return;
      const dialog = openDialog;
      openDialog = null;
      hideDialog(dialog);
    });
    if (!supportsDialog) {
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && openDialog) hideDialog(openDialog);
      });
    }

    // menu links: close the menu, scroll to the section, move focus there
    const menuDialog = getDialog('menu');
    $$<HTMLAnchorElement>('[data-nav]').forEach((link) =>
      link.addEventListener('click', (event) => {
        const hash = link.getAttribute('href');
        const target = hash ? $(hash) : null;
        if (!hash || !target) return;
        event.preventDefault();
        if (menuDialog) closeSilently(menuDialog);
        history.replaceState(null, '', hash);
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
          target.focus({ preventScroll: true });
        });
      }),
    );
  });

  /* ---------- theme switch ---------- */
  run('theme', () => {
    const themeSwitch = $('[data-theme-toggle]');
    const syncSwitch = (): void => themeSwitch?.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
    syncSwitch();
    themeSwitch?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* storage unavailable */ }
      syncSwitch();
    });
    const scheme = matchMedia('(prefers-color-scheme: dark)');
    if (typeof scheme.addEventListener === 'function') {
      scheme.addEventListener('change', (event) => {
        let stored: string | null = null;
        try { stored = localStorage.getItem('theme'); } catch { /* storage unavailable */ }
        if (stored) return;
        root.dataset.theme = event.matches ? 'dark' : 'light';
        syncSwitch();
      });
    }
  });

  /* ---------- copy email ---------- */
  run('copy', () => {
    const selectText = (el: Element): void => {
      const range = document.createRange();
      range.selectNodeContents(el);
      const selection = getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
    };
    $$('[data-copy]').forEach((button) => {
      const label = $('.txt', button);
      if (!label) return;
      const original = label.textContent ?? '';
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          const mail = $('.mail');
          if (mail) selectText(mail); // clipboard unavailable: select the address so it can be copied by hand
        }
        button.classList.add('done');
        label.textContent = button.dataset.done ?? original;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.classList.remove('done');
          label.textContent = original;
        }, 1800);
      });
    });
  });

  /* ---------- adaptive performance: measure real frame rate, then downgrade effects if needed ---------- */
  type Tier = 'high' | 'medium' | 'low';
  const tierRank: Record<Tier, number> = { high: 0, medium: 1, low: 2 };
  const currentTier = (): Tier => (root.dataset.perf === 'low' || root.dataset.perf === 'medium' ? root.dataset.perf : 'high');
  function setTier(tier: Tier): void {
    root.dataset.perf = tier;
    try { sessionStorage.setItem('perf', tier); } catch { /* storage unavailable */ }
  }
  function probeFrameRate(): void {
    if (document.hidden || currentTier() === 'low') return;
    const deltas: number[] = [];
    let previous = 0;
    const tick = (now: number): void => {
      if (document.hidden) return;
      if (previous) deltas.push(now - previous);
      previous = now;
      if (deltas.length < 45) {
        requestAnimationFrame(tick);
        return;
      }
      deltas.sort((a, b) => a - b);
      const median = deltas[Math.floor(deltas.length / 2)];
      const measured: Tier = median > 34 ? 'low' : median > 22 ? 'medium' : 'high';
      setTier(tierRank[measured] > tierRank[currentTier()] ? measured : currentTier());
    };
    requestAnimationFrame(tick);
  }
  run('perf', () => {
    const start = (): void => void window.setTimeout(probeFrameRate, 1800);
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  });

  root.classList.add('ready');
</script>
