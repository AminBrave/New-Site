---
interface Props {
  w: { title: string; client?: string; color: string; logo?: string };
  size?: 'md' | 'sm';
}

const { w, size = 'md' } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (path: string): string => (/^(https?:)?\/\//.test(path) ? path : `${root}/${path.replace(/^\//, '')}`);
const label = w.client || w.title;
const initials = label
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => [...word][0])
  .join('');
---
<span class={`logo-tile ${size}`} style={`--c:${w.color}`}>
  <span class="mono" aria-hidden="true">{initials}</span>
  {w.logo && <img src={src(w.logo)} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
</span>
