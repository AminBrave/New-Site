---
import Icon from './Icon.astro';
import { rich } from '../lib/rich';
import type { Locale } from '../data/types';
import type { ResumeContent } from '../data/resume';

interface Props { t: Locale; r: ResumeContent }
const { t, r } = Astro.props;
---
    <section id="resume" tabindex="-1" data-section><div class="wrap">
      <div class="sh" data-reveal><span class="tile"><Icon name="file" size={24} /></span><h2>{t.resumeHead}</h2></div>
      <p class="sub" data-reveal style="--d:1">{r.sub}</p>
      <div class="btns cv-actions" data-reveal style="--d:2">
        <button class="btn primary" type="button" data-open="cv" aria-haspopup="dialog"><Icon name="file" size={18} /><span>{r.preview}</span></button>
        <button class="btn" type="button" data-open="cv" data-print aria-haspopup="dialog"><Icon name="download" size={18} /><span>{r.download}</span></button>
      </div>
      <ul class="xp">
        {r.jobs.map((e, i) => (
          <li data-reveal style={`--d:${i};--k:${i}`}>
            <span class="dot"><Icon name="briefcase" size={14} /></span>
            <article class="xp-card">
              <header class="xp-head">
                <span class="xp-when">{e.period}</span>
                <h3>{e.role}</h3>
                <p class="xp-org"><strong>{e.org}</strong><span aria-hidden="true">·</span><span class="xp-plc"><Icon name="pin" size={14} />{e.place}</span></p>
              </header>
              <ul class="xp-pts">{e.points.map((p) => <li><Icon name="check" size={18} /><span set:html={rich(p)} /></li>)}</ul>
              <div class="xp-stack"><span class="xp-lbl">{r.stackLabel}</span><ul class="chips sm">{e.stack.map((s) => <li>{s}</li>)}</ul></div>
            </article>
          </li>
        ))}
      </ul>
    </div></section>
