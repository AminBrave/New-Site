{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build --host",
    "preview": "astro preview --host",
    "check": "astro check",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "check:theme": "tsx scripts/check-theme.ts",
    "verify": "npm run lint:css && npm run check:theme && astro check && astro build"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "postcss-scss": "^4.0.9",
    "sass": "^1.106.0",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14",
    "samsung >= 14"
  ]
}
